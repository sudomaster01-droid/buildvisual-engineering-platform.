# ---- core -------------------------------------------------------------
APP_ENV=development
APP_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:8000
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/buildvisual.db

# ---- the single engineer account -------------------------------------
ENGINEER_EMAIL=engineer@example.com
ENGINEER_PASSWORD=
ENGINEER_NAME=Engineer

# ---- interpretation (drawing vision + optional rectification LLM) -----
LLM_PROVIDER=none            # production: none | local_openai; hosted choices are development-only
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=http://127.0.0.1:8001/v1

# ---- speech ----------------------------------------------------------
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_MODEL_PATH=./models/faster-whisper-small
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_COMPUTE_TYPE=int8

# ---- video provider --------------------------------------------------
VIDEO_PROVIDER=local_render   # production default: deterministic model render, no hosted call
GEMINI_API_KEY=               # development/test only; hosted video is blocked in production
VEO_MODEL=gemini-omni-1.1-flash
RUNWAY_API_KEY=               # development/test only; hosted video is blocked in production
RUNWAY_MODEL=gen4.5

# ---- spend controls (US cents) ---------------------------------------
VEO_COST_CENTS_PER_SECOND=15
RUNWAY_COST_CENTS_PER_SECOND=12
MAX_PROVIDER_ATTEMPTS_PER_SHOT=2
MAX_JOB_SPEND_CENTS=1500
DAILY_SPEND_CEILING_CENTS=5000

# ---- pipeline --------------------------------------------------------
RUN_WORKER_INLINE=true
WORKER_POLL_INTERVAL_SECONDS=1.0
JOB_MAX_RUNTIME_SECONDS=2700
STEP_TIMEOUT_SECONDS=1200
MAX_SHOTS=4
SHOT_SECONDS=8
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=24
