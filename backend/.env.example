# ---- core -------------------------------------------------------------
APP_ENV=development
APP_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:8000
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/buildvisual.db

# ---- the single engineer account -------------------------------------
ENGINEER_EMAIL=engineer@example.com
ENGINEER_PASSWORD=choose-a-strong-password
ENGINEER_NAME=Engineer

# ---- interpretation (drawing vision + optional rectification LLM) -----
LLM_PROVIDER=none            # none | gemini | openai | anthropic
LLM_API_KEY=
LLM_MODEL=

# ---- speech ----------------------------------------------------------
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_API_KEY=        # falls back to LLM_API_KEY when the provider is OpenAI
TRANSCRIPTION_MODEL=whisper-1

# ---- video provider --------------------------------------------------
VIDEO_PROVIDER=auto           # auto | veo | runway | local_render
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-fast-generate-preview
RUNWAY_API_KEY=
RUNWAY_MODEL=gen4.5

# ---- spend controls (US cents) ---------------------------------------
VEO_COST_CENTS_PER_SECOND=15
RUNWAY_COST_CENTS_PER_SECOND=12
MAX_PROVIDER_ATTEMPTS_PER_SHOT=2
MAX_JOB_SPEND_CENTS=1500
DAILY_SPEND_CEILING_CENTS=5000

# ---- pipeline --------------------------------------------------------
RUN_WORKER_INLINE=true
WORKER_POLL_INTERVAL_SECONDS=1.0
JOB_MAX_RUNTIME_SECONDS=2700
STEP_TIMEOUT_SECONDS=1200
MAX_SHOTS=4
SHOT_SECONDS=8
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=24
